{
  "name": "tnz-view",
  "displayName": "TNZ 3270",
  "description": "Native 3270 terminal view for VS Code and Cursor, powered by IBM tnz.",
  "version": "0.2.0",
  "publisher": "mdavage",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/spufidoo/tnz-view.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "3270",
    "tn3270",
    "mainframe",
    "z/OS",
    "ISPF"
  ],
  "activationEvents": [
    "onView:tnzView.hosts"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TNZ 3270",
      "properties": {
        "tnzView.hosts": {
          "type": "array",
          "default": [],
          "description": "Saved 3270 host connection profiles.",
          "items": {
            "type": "object"
          }
        },
        "tnzView.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 3.10+ interpreter that has the tnz package installed. Empty uses PATH / py launcher."
        },
        "tnzView.keymap": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override 3270 key bindings. Each entry maps a chord such as `alt+1` to an action: `aid:<name>` (enter, clear, attn, pa1-3, pf1-24), `nav:<name>` (tab, backtab, left, right, up, down, home, end, wordleft, wordright, backspace, delete, eraseeof, eraseinput, newline) or `local:<name>` (insert, reset). An empty value removes a default binding. Run **TNZ 3270: Show Keyboard Map** to see the result, or see [docs/KEYMAP.md](https://github.com/spufidoo/tnz-view/blob/main/docs/KEYMAP.md).",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tnzView.transfer.idleTimeout": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "markdownDescription": "Seconds to wait for IND$FILE to respond before giving up. The clock resets whenever the transfer makes progress, so this only fires when the host has gone quiet — usually because the command was typed somewhere that is not a ready prompt."
        },
        "tnzView.transfer.options": {
          "type": "string",
          "default": "",
          "markdownDescription": "IND$FILE options offered as the default when starting a transfer, for example `RECFM(V) LRECL(255)`. `ASCII` and `CRLF` are added automatically for text transfers."
        },
        "tnzView.tnzPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a local IBM/tnz checkout added to PYTHONPATH (for development)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tnzView",
          "title": "TNZ 3270",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tnzView": [
        {
          "id": "tnzView.hosts",
          "name": "Hosts"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tnzView.hosts",
        "contents": "No 3270 hosts yet.\n[Add Host](command:tnzView.hosts.add)\nRequires Python 3.10+ and `pip install tnz ebcdic`."
      }
    ],
    "commands": [
      {
        "command": "tnzView.hosts.add",
        "title": "Add Host",
        "icon": "$(add)",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.hosts.edit",
        "title": "Edit Host",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.hosts.delete",
        "title": "Delete Host",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.hosts.duplicate",
        "title": "Duplicate Host",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.hosts.connect",
        "title": "Connect",
        "icon": "$(debug-start)",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.hosts.disconnect",
        "title": "Disconnect",
        "icon": "$(debug-disconnect)",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.session.clear",
        "title": "Send CLEAR",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.session.attn",
        "title": "Send ATTN",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.showKeymap",
        "title": "Show Keyboard Map",
        "category": "TNZ 3270"
      },
      {
        "command": "tnzView.session.download",
        "title": "Download File from Host (IND$FILE)",
        "category": "TNZ 3270",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tnzView.session.upload",
        "title": "Upload File to Host (IND$FILE)",
        "category": "TNZ 3270",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tnzView.hosts.add",
          "when": "view == tnzView.hosts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tnzView.hosts.connect",
          "when": "view == tnzView.hosts && viewItem == host",
          "group": "inline"
        },
        {
          "command": "tnzView.hosts.disconnect",
          "when": "view == tnzView.hosts && viewItem == hostConnected",
          "group": "inline"
        },
        {
          "command": "tnzView.hosts.connect",
          "when": "view == tnzView.hosts && viewItem == host",
          "group": "1_session"
        },
        {
          "command": "tnzView.hosts.disconnect",
          "when": "view == tnzView.hosts && viewItem == hostConnected",
          "group": "1_session"
        },
        {
          "command": "tnzView.hosts.edit",
          "when": "view == tnzView.hosts && viewItem =~ /host/",
          "group": "2_edit"
        },
        {
          "command": "tnzView.hosts.duplicate",
          "when": "view == tnzView.hosts && viewItem =~ /host/",
          "group": "2_edit"
        },
        {
          "command": "tnzView.hosts.delete",
          "when": "view == tnzView.hosts && viewItem =~ /host/",
          "group": "3_delete"
        }
      ],
      "editor/title": [
        {
          "command": "tnzView.session.download",
          "when": "activeWebviewPanelId == tnzView.session",
          "group": "navigation@1"
        },
        {
          "command": "tnzView.session.upload",
          "when": "activeWebviewPanelId == tnzView.session",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "tnzView.session.download",
          "when": "tnzView.sessionActive"
        },
        {
          "command": "tnzView.session.upload",
          "when": "tnzView.sessionActive"
        },
        {
          "command": "tnzView.session.attn",
          "when": "tnzView.sessionActive"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tnzView.session.clear",
        "key": "pause",
        "when": "tnzView.sessionActive"
      },
      {
        "command": "tnzView.session.attn",
        "key": "alt+a",
        "when": "tnzView.sessionActive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
